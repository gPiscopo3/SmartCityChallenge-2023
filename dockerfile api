FROM ubuntu:latest

# Aggiornamento dei repository, installazione di java e maven
RUN apt-get update && apt-get install -y openjdk-18-jdk

RUN mkdir /Challenge
COPY /target/api-jar-with-dependencies.jar /Challenge
COPY config.xml /Challenge

WORKDIR /Challenge

RUN chmod 775 api-jar-with-dependencies.jar 

ENTRYPOINT [ "java", "jar", "api-jar-with-dependencies.jar"]